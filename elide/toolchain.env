# elide-dev/toolchain bundle for the static JNI archives (elide/build-static.sh).
# TOOLCHAIN_VERSION: a release (e.g. 2026.10.0). Until the first release, TOOLCHAIN_CI_RUN names an
# elide-dev/toolchain CI run whose elide-toolchain-<os>-<arch> artifacts are installed instead.
# Keep AWS-LC in lockstep: the bundle's AWS_LC_VERSION must equal awsLcMainTag in build.gradle.
TOOLCHAIN_VERSION=2026.10.2
TOOLCHAIN_CI_RUN=
TOOLCHAIN_ACTION_REF=b6c36aae373b3efb75527a8ad3cbc14f9d280fea
